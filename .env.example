# ============================================================
# GridPortfolio Environment Configuration
# ============================================================
#
# Copy this file to:
#
#     .env
#
# Never commit .env to source control.
#
# The application is designed to run without an LLM.
# AI features are enabled only when an LLM provider is configured.
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

APP_NAME=GridPortfolio
APP_ENV=development
APP_VERSION=0.1.0

HOST=0.0.0.0
PORT=8000

LOG_LEVEL=INFO

# Enable/disable API documentation
ENABLE_API_DOCS=true


# ------------------------------------------------------------
# Synthetic Data
# ------------------------------------------------------------

# All demo data is synthetic and reproducible.
RANDOM_SEED=42

# Number of synthetic portfolio assets
NUM_ASSETS=25

# Number of synthetic contracts
NUM_CONTRACTS=40

# Number of synthetic initiatives
NUM_INITIATIVES=20

# Number of historical hours to generate
HISTORICAL_HOURS=8760


# ------------------------------------------------------------
# Data Storage
# ------------------------------------------------------------

DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
SCENARIO_DATA_DIR=data/scenarios

# Default local analytical database
DUCKDB_PATH=data/gridportfolio.duckdb


# ------------------------------------------------------------
# LLM / AI
# ------------------------------------------------------------

# Supported values:
#
#   none
#   openai
#
# The application should remain fully functional with:
#
#   LLM_PROVIDER=none
#
# AI agents should gracefully degrade to deterministic
# analytics when no LLM is configured.

LLM_PROVIDER=none

# Example:
#
# LLM_PROVIDER=openai
# LLM_MODEL=<your-model>

LLM_MODEL=

# Do not commit API keys.
LLM_API_KEY=

# Optional OpenAI-compatible endpoint.
#
# Leave blank to use the provider default.

LLM_BASE_URL=


# ------------------------------------------------------------
# AI Behavior
# ------------------------------------------------------------

# Temperature should generally remain low for
# decision-support workflows.

LLM_TEMPERATURE=0.1

# Maximum tokens allocated to an individual agent response.

LLM_MAX_TOKENS=2500

# Require evidence references in AI-generated outputs.

REQUIRE_EVIDENCE=true

# Require explicit distinction between:
#
#   FACT
#   MODEL_OUTPUT
#   AI_INTERPRETATION
#   RECOMMENDATION
#
SEPARATE_FACTS_FROM_INFERENCE=true


# ------------------------------------------------------------
# Agent Configuration
# ------------------------------------------------------------

ENABLE_AGENTS=true

ENABLE_INTEGRATION_AGENT=true
ENABLE_RISK_AGENT=true
ENABLE_DECISION_AGENT=true
ENABLE_BRIEFING_AGENT=true

# Agents should never make autonomous procurement decisions.

ALLOW_AUTONOMOUS_PROCUREMENT_DECISIONS=false


# ------------------------------------------------------------
# Analytics
# ------------------------------------------------------------

# Forecast horizon in hours.

FORECAST_HORIZON_HOURS=24

# Minimum confidence required before an alert is promoted
# from informational to actionable.

ALERT_CONFIDENCE_THRESHOLD=0.75

# Anomaly detection sensitivity.

ANOMALY_CONTAMINATION=0.01


# ------------------------------------------------------------
# Portfolio Health
# ------------------------------------------------------------

# Weights should sum to 1.0.

HEALTH_WEIGHT_RELIABILITY=0.20
HEALTH_WEIGHT_MARKET_EXPOSURE=0.20
HEALTH_WEIGHT_CONTRACT_COVERAGE=0.15
HEALTH_WEIGHT_RENEWABLE_COVERAGE=0.15
HEALTH_WEIGHT_PRICE_RISK=0.10
HEALTH_WEIGHT_FORECAST_STABILITY=0.10
HEALTH_WEIGHT_EXECUTION_HEALTH=0.10


# ------------------------------------------------------------
# API
# ------------------------------------------------------------

API_PREFIX=/api/v1

# CORS configuration for local development.
#
# In production, replace with explicit trusted origins.

CORS_ORIGINS=http://localhost:3000,http://localhost:8501


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

# Local default:
#
# DATABASE_URL=duckdb:///data/gridportfolio.duckdb
#
# Optional PostgreSQL:
#
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/gridportfolio

DATABASE_URL=duckdb:///data/gridportfolio.duckdb


# ------------------------------------------------------------
# Observability
# ------------------------------------------------------------

ENABLE_STRUCTURED_LOGGING=true

# Log agent inputs/outputs only in development.
#
# Production systems should carefully control logging
# of potentially sensitive information.

LOG_AGENT_INPUTS=false
LOG_AGENT_OUTPUTS=true

# Never log secrets.

LOG_SECRETS=false


# ------------------------------------------------------------
# Responsible AI
# ------------------------------------------------------------

# Require every recommendation to include a traceable
# evidence chain.

REQUIRE_RECOMMENDATION_EVIDENCE=true

# Require confidence scores on AI-generated recommendations.

REQUIRE_CONFIDENCE_SCORES=true

# Prevent agents from presenting recommendations
# as autonomous decisions.

HUMAN_DECISION_REQUIRED=true


# ------------------------------------------------------------
# Development
# ------------------------------------------------------------

DEBUG=true

# Enable synthetic scenario endpoints.

ENABLE_SCENARIOS=true

# Automatically generate demo data if the database is empty.

AUTO_SEED_DATABASE=true